# ===========================
# LiveKit Configuration
# ===========================
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# ===========================
# AI Provider Keys
# ===========================
OPENAI_API_KEY=your-openai-api-key
CARTESIA_API_KEY=your-cartesia-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key

# ===========================
# Agent Configuration
# ===========================
AGENT_PROMPT="You are a helpful voice AI assistant. You eagerly assist users with their questions. Your responses are concise, to the point, and without any complex formatting or punctuation including emojis, asterisks, or other symbols. You are curious, friendly, and have a sense of humor."
LLM_MODEL=gpt-4o
VOICE=79a125e8-cd45-4c13-8a67-188112f4dd22
TTS_PROVIDER=cartesia
STT_PROVIDER=deepgram
TIMEZONE=gmt+0
LANGUAGE=English

# ===========================
# API Settings
# ===========================
API_HOST=0.0.0.0
API_PORT=8001
ENVIRONMENT=production
LOG_LEVEL=INFO

# ===========================
# Health Check Settings
# ===========================
HEALTH_CHECK_INTERVAL=30
AGENT_STARTUP_TIMEOUT=60
